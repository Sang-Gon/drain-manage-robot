# 배수로 탐지 1건.
#
# 주의: 이 파일의 주석에 줄 끝 역슬래시를 쓰지 말 것.
#       rosidl_adapter 가 IDL 템플릿에 주석을 넣을 때 유니코드 이스케이프로
#       해석해 빌드가 깨진다. (실제로 겪은 문제)

string  label            # 클래스 이름. 현재 모델은 "drain" 하나뿐
float32 score            # 신뢰도 0.0 ~ 1.0

# 원본 영상 픽셀 좌표. 좌상단이 원점
int32   x1
int32   y1
int32   x2
int32   y2

# ── 서보잉용 파생값 (여기서 미리 계산해 소비자가 픽셀 산수를 안 하게 한다) ──
# cx_norm : bbox 중심의 가로 위치. -1.0 = 화면 왼쪽 끝, 0.0 = 정중앙, +1.0 = 오른쪽 끝
#           그대로 조향 오차로 쓸 수 있다
float32 cx_norm
# cy_norm : 세로 위치. -1.0 = 위쪽 끝, 0.0 = 중앙, +1.0 = 아래쪽 끝
#           아래로 갈수록 로봇에 가깝다 (전방 주시 카메라 기준)
float32 cy_norm
# area_ratio : bbox 면적 / 전체 영상 면적. 거리 대용 지표
#              깊이 센서가 아니므로 절대 거리로 쓰지 말 것. TOF 가 붙으면 그쪽이 정답
float32 area_ratio
