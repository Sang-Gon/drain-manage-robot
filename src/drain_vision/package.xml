<?xml version="1.0"?>
<package format="3">
  <name>drain_vision</name>
  <version>0.1.0</version>
  <description>USB 카메라 + Hailo YOLOv11s 배수로 탐지 노드 (Main ECU / 라즈베리파이5)</description>
  <maintainer email="team@example.com">team</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>robot_interfaces</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- hailo_platform 은 rosdep 키가 없다. HailoRT 를 수동 설치할 것 (README 참고) -->

  <export><build_type>ament_python</build_type></export>
</package>
